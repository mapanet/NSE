    B.NSE_D_PCT      = C.NSE_D_PCT,
    B.NSE_E_PCT     = C.NSE_E_PCT
FROM Boundaries B
JOIN COLONIA_NSE C
    ON B.CVEGEO = C.CVE_COLONIA
WHERE B.Layer = 6;
