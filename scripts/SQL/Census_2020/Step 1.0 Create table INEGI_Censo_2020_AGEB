-- CVEGEO is correct ?
----------------------

SELECT TOP 20 CVEGEO, LEN(CVEGEO) as Len
FROM INEGI_Censo_2020_AGEB;

-----------------
-- Delete staging
-----------------

DROP TABLE IF EXISTS INEGI_Censo_2020_AGEB_Staging;
GO
